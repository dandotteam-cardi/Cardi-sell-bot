#!/usr/bin/env bash
# /usr/local/sbin/sellbot-provision  —  فقط از طریق sudo توسط ربات فروش اجرا می‌شود
# Usage: sellbot-provision {install|update-env|start|stop|restart|status|logs|remove} <user_id>-<order_id>
set -Eeuo pipefail

CONF="/etc/sellbot-provision.conf"
[[ -r "$CONF" ]] || { echo "config-missing"; exit 2; }
# shellcheck disable=SC1090
. "$CONF"
: "${REPO_URL:?}" "${BASE_DIR:?}" "${PYTHON_BIN:?}"
BRANCH="${BRANCH:-main}"
ENTRY="${ENTRY:-bot.py}"

action="${1:-}"
slug="${2:-}"
[[ "$slug" =~ ^[0-9]{1,20}-[0-9]{1,12}$ ]] || { echo "bad-slug"; exit 2; }

DIR="$BASE_DIR/$slug"
UNIT="sellbot-c${slug}"
SVC_USER="sbc${slug}"
UNIT_FILE="/etc/systemd/system/${UNIT}.service"
(( ${#SVC_USER} <= 32 )) || { echo "slug-too-long"; exit 2; }
[[ "$DIR" == "$BASE_DIR"/* ]] || { echo "bad-path"; exit 2; }

GIT() { git -c "safe.directory=$DIR" "$@"; }

unit_exists() { [[ -f "$UNIT_FILE" ]]; }

write_env() {  # stdin -> $DIR/.env (اتمیک، فقط خواندنی برای کاربر ربات)
  local tmp
  tmp="$(mktemp "$DIR/.env.XXXXXX")"
  cat > "$tmp"
  [[ -s "$tmp" ]] || { rm -f "$tmp"; echo "empty-env"; exit 3; }
  chown "$SVC_USER":"$SVC_USER" "$tmp"
  chmod 600 "$tmp"
  mv -f "$tmp" "$DIR/.env"
}

case "$action" in
  install)
    mkdir -p "$BASE_DIR"
    if ! id -u "$SVC_USER" >/dev/null 2>&1; then
      useradd --system --home-dir "$DIR" --no-create-home \
        --shell "$(command -v nologin || echo /usr/sbin/nologin)" "$SVC_USER"
    fi
    if [[ -d "$DIR/.git" ]]; then
      GIT -C "$DIR" fetch --depth 1 origin "$BRANCH"
      GIT -C "$DIR" reset --hard "origin/$BRANCH"
    else
      [[ ! -e "$DIR" || -z "$(ls -A "$DIR" 2>/dev/null)" ]] || { echo "dir-not-empty"; exit 3; }
      git clone --depth 1 --branch "$BRANCH" "$REPO_URL" "$DIR"
    fi
    [[ -f "$DIR/$ENTRY" ]] || { echo "entry-not-found: $ENTRY"; exit 3; }
    [[ -x "$DIR/venv/bin/python" ]] || "$PYTHON_BIN" -m venv "$DIR/venv"
    "$DIR/venv/bin/pip" install -q --upgrade pip
    if [[ -f "$DIR/requirements.txt" ]]; then
      "$DIR/venv/bin/pip" install -q -r "$DIR/requirements.txt"
    fi
    write_env
    chown -R "$SVC_USER":"$SVC_USER" "$DIR"
    cat > "$UNIT_FILE" <<UNIT
[Unit]
Description=Customer bot ${slug}
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=${SVC_USER}
WorkingDirectory=${DIR}
ExecStart=${DIR}/venv/bin/python ${ENTRY}
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true

[Install]
WantedBy=multi-user.target
UNIT
    systemctl daemon-reload
    systemctl enable "$UNIT" >/dev/null 2>&1
    systemctl restart "$UNIT"
    sleep 3
    systemctl is-active --quiet "$UNIT" || { journalctl -u "$UNIT" -n 20 --no-pager || true; echo "service-not-active"; exit 4; }
    echo "installed"
    ;;

  update-env)
    [[ -d "$DIR" ]] && unit_exists || { echo "not-installed"; exit 3; }
    write_env
    if systemctl is-active --quiet "$UNIT"; then
      systemctl restart "$UNIT"
      echo "env-updated-restarted"
    else
      echo "env-updated"
    fi
    ;;

  start)
    unit_exists || { echo "not-installed"; exit 3; }
    systemctl enable "$UNIT" >/dev/null 2>&1 || true
    systemctl start "$UNIT"
    echo "started"
    ;;

  stop)
    unit_exists || { echo "not-installed"; exit 3; }
    systemctl disable --now "$UNIT" >/dev/null 2>&1 || systemctl stop "$UNIT"
    echo "stopped"
    ;;

  restart)
    unit_exists || { echo "not-installed"; exit 3; }
    systemctl restart "$UNIT"
    echo "restarted"
    ;;

  status)
    if ! unit_exists; then echo "missing"; exit 0; fi
    systemctl is-active "$UNIT" || true
    ;;

  logs)
    unit_exists || { echo "not-installed"; exit 3; }
    journalctl -u "$UNIT" -n 40 --no-pager || true
    ;;

  remove)
    systemctl disable --now "$UNIT" >/dev/null 2>&1 || true
    rm -f "$UNIT_FILE"
    systemctl daemon-reload
    id -u "$SVC_USER" >/dev/null 2>&1 && userdel "$SVC_USER" 2>/dev/null || true
    [[ -n "$BASE_DIR" && "$DIR" == "$BASE_DIR"/* && -d "$DIR" ]] && rm -rf -- "$DIR"
    echo "removed"
    ;;

  *)
    echo "usage: $0 {install|update-env|start|stop|restart|status|logs|remove} <slug>"
    exit 2
    ;;
esac
